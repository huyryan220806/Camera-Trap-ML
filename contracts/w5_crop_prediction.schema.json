{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W5 crop validation submission (one JSONL row)",
  "description": "Exactly one row for every frozen validation crop, in declared class order. Synthetic unit fixtures are not model results.",
  "type": "object",
  "required": ["crop_id", "image_id", "ground_truth"],
  "additionalProperties": false,
  "oneOf": [{"required": ["class_scores"]}, {"required": ["logits"]}],
  "properties": {
    "crop_id": {"type": "string", "minLength": 1},
    "image_id": {"type": "string", "minLength": 1},
    "ground_truth": {"type": "integer", "minimum": 0, "maximum": 7},
    "class_scores": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "logits": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "number"}}
  }
}
