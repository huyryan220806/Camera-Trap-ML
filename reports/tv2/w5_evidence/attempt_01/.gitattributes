# Preserve captured logs byte-for-byte, including logger-emitted terminal spaces.
# Source-code whitespace checks remain enabled outside generated .log evidence.
*.log -text whitespace=-blank-at-eol,cr-at-eol
*.txt -text whitespace=cr-at-eol
*.csv -text whitespace=cr-at-eol
*.json -text whitespace=cr-at-eol
*.jsonl -text
