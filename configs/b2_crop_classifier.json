{
  "experiment_name": "b2_crop_classifier_comparison_v1",
  "version": "1.0.0",
  "author": "TV3",
  "task": "W3-02: Fine-tune B2 trên vùng cắt",
  "model": {
    "backbone": "resnet18",
    "pretrained": true,
    "num_classes": 8,
    "dropout_p": 0.2
  },
  "training": {
    "epochs": 15,
    "batch_size": 32,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "seed": 42,
    "loss_weighting": "per_image",
    "early_stopping_patience": 5,
    "mixed_precision": true
  },
  "data": {
    "dataset_version": "comparison_v1",
    "manifest_train": "data/processed/comparison_v1/b2/train.jsonl",
    "manifest_val": "data/processed/comparison_v1/b2/val.jsonl",
    "class_map": "data/processed/comparison_v1/class_map.json",
    "provenance": "data/processed/comparison_v1/provenance.json",
    "image_size": 224,
    "num_workers": 4,
    "preflight_hash_check": false
  },
  "evaluation": {
    "metric_for_best": "image_macro_f1",
    "aggregation_method": "mean_probability_argmax",
    "compare_with_b1": true
  },
  "output": {
    "dir": "outputs/b2_crop_classifier",
    "best_checkpoint": "outputs/b2_crop_classifier/best_model.pt",
    "last_checkpoint": "outputs/b2_crop_classifier/last_model.pt",
    "log_file": "outputs/b2_crop_classifier/train_log.jsonl",
    "val_report": "outputs/b2_crop_classifier/validation_comparison.json",
    "val_table_md": "outputs/b2_crop_classifier/validation_comparison.md"
  }
}
